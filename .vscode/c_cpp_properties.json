{
  "env": {
    "minix.include": "${workspaceFolder}/.minix-src/include"
  },
  "configurations": [{
    "name": "Minix",
    "compilerPath": "",
    "cStandard": "c11",
    "defines": ["__minix", "_MINIX", "_NETBSD_SOURCE", "__i386__"],
    "includePath": [
      "${workspaceFolder}",
      "${env:minix.include}",
      "${workspaceFolder}/lab2",
      "${workspaceFolder}/lab3",
      "${workspaceFolder}/lab4",
      "${workspaceFolder}/lab5",
      "${workspaceFolder}/proj/src",
      "${workspaceFolder}/proj/src/menu",
      "${workspaceFolder}/proj/src/game"
    ],
    "browse": {
      "path": ["${workspaceFolder}", "${env:minix.include}"],
      "limitSymbolsToIncludedHeaders": false,
      "databaseFilename": ""
    }
  }],
  "version": 4
}

